# Local development defaults. Copy this file to .env and adjust as needed.
APP_ENV=development
LOG_LEVEL=INFO

# Kafka is exposed to host clients only on the loopback interface.
KAFKA_HOST_PORT=29092
KAFKA_UI_PORT=8080

# Safe local-only storage defaults. Replace these values outside local development.
POSTGRES_HOST_PORT=5432
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce_local_dev
POSTGRES_DSN=postgresql://commerce:commerce_local_dev@postgres:5432/commerce
REDIS_HOST_PORT=6379

# Event generator defaults. The service uses kafka:9092 inside Compose.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EVENTS_TOPIC=commerce.events
KAFKA_CLIENT_ID=event-generator
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_LINGER_MS=20
KAFKA_BATCH_SIZE=65536
KAFKA_DELIVERY_TIMEOUT_MS=30000
KAFKA_REQUEST_TIMEOUT_MS=10000
GENERATOR_RATE_PER_SECOND=1.0
GENERATOR_MAX_PRODUCT_VIEWS=20
GENERATOR_ADD_TO_CART_PROBABILITY=0.55
GENERATOR_CHECKOUT_PROBABILITY=0.70
GENERATOR_PAYMENT_SUCCESS_PROBABILITY=0.85
GENERATOR_REFUND_PROBABILITY=0.05
GENERATOR_SEED=
GENERATOR_LOG_LEVEL=INFO
GENERATOR_FLUSH_TIMEOUT_SECONDS=10
GENERATOR_JOURNEYS=
GENERATOR_CUSTOMER_POOL_SIZE=100
GENERATOR_NEW_CUSTOMER_PROBABILITY=0.35
GENERATOR_PERSONA_WEIGHTS=normal=0.50,indecisive=0.15,discount_hunter=0.15,suspicious=0.10,bot=0.05,account_takeover=0.05
GENERATOR_STATEFUL_MODE=true
GENERATOR_MAX_PAYMENT_ATTEMPTS=3
GENERATOR_PAYMENT_RETRY_PROBABILITY=0.65

# Controlled raw anomalies are disabled unless explicitly enabled.
GENERATOR_ANOMALIES_ENABLED=false
GENERATOR_DUPLICATE_EVENT_PROBABILITY=0
GENERATOR_MALFORMED_JSON_PROBABILITY=0
GENERATOR_MISSING_FIELD_PROBABILITY=0
GENERATOR_UNKNOWN_EVENT_TYPE_PROBABILITY=0
GENERATOR_LATE_EVENT_PROBABILITY=0
GENERATOR_OUT_OF_ORDER_PROBABILITY=0
GENERATOR_PAYLOAD_MISMATCH_PROBABILITY=0
GENERATOR_MAX_LATE_EVENT_SECONDS=86400
GENERATOR_MAX_ANOMALIES_PER_JOURNEY=2

# Event processor defaults. Redis holds operational idempotency leases only.
PROCESSOR_INPUT_TOPIC=commerce.events
PROCESSOR_DLQ_TOPIC=commerce.events.dlq
PROCESSOR_CONSUMER_GROUP=commerce-event-processor-v1
PROCESSOR_CLIENT_ID=commerce-event-processor
PROCESSOR_AUTO_OFFSET_RESET=earliest
PROCESSOR_SESSION_TIMEOUT_MS=10000
PROCESSOR_HEARTBEAT_INTERVAL_MS=3000
PROCESSOR_MAX_POLL_INTERVAL_MS=300000
PROCESSOR_POLL_TIMEOUT_SECONDS=1
PROCESSOR_IDLE_TIMEOUT_SECONDS=10
PROCESSOR_MAX_PROCESSING_ATTEMPTS=3
PROCESSOR_RETRY_INITIAL_BACKOFF_MS=100
PROCESSOR_RETRY_MAX_BACKOFF_MS=2000
PROCESSOR_RETRY_MULTIPLIER=2
PROCESSOR_RETRY_JITTER_RATIO=0.1
PROCESSOR_IDEMPOTENCY_PROCESSING_TTL_SECONDS=60
PROCESSOR_IDEMPOTENCY_COMPLETED_TTL_SECONDS=604800
PROCESSOR_IDEMPOTENCY_KEY_PREFIX=commerce:processor:v1:event
PROCESSOR_REDIS_SOCKET_TIMEOUT_SECONDS=2
PROCESSOR_REDIS_CONNECT_TIMEOUT_SECONDS=2
PROCESSOR_DLQ_MAX_PAYLOAD_BYTES=65536
PROCESSOR_DLQ_DELIVERY_TIMEOUT_MS=10000
PROCESSOR_SHUTDOWN_TIMEOUT_SECONDS=10
PROCESSOR_LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0
PROCESSOR_DB_POOL_MIN_SIZE=1
PROCESSOR_DB_POOL_MAX_SIZE=4
PROCESSOR_DB_CONNECT_TIMEOUT_SECONDS=5
PROCESSOR_DB_ACQUIRE_TIMEOUT_SECONDS=5
PROCESSOR_DB_STATEMENT_TIMEOUT_MS=5000
PROCESSOR_DB_MAX_IDLE_SECONDS=300
PROCESSOR_DB_HEALTHCHECK_INTERVAL_SECONDS=30
PROCESSOR_DB_STARTUP_ATTEMPTS=5
PROCESSOR_DB_STARTUP_BACKOFF_SECONDS=1
PROCESSOR_REQUIRED_SCHEMA_VERSION=2
PROCESSOR_PERSIST_RAW_EVENT_JSON=true
PROCESSOR_DB_LOG_SLOW_QUERY_MS=250
