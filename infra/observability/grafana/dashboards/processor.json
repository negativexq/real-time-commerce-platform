{
  "uid": "commerce-processor", "title": "Event Processor", "description": "Source validation, idempotency, persistence, terminal outcomes, and manual offset commits.", "schemaVersion": 41, "version": 1, "refresh": "10s", "time": {"from": "now-1h", "to": "now"}, "tags": ["commerce", "processor"], "templating": {"list": []},
  "panels": [
    {"id": 1, "title": "Events received by event type", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (event_type) (rate(commerce_processor_events_received_total[5m]))", "legendFormat": "{{event_type}}"}]},
    {"id": 2, "title": "Terminal outcomes", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum by (result) (rate(commerce_processor_events_terminal_total[5m]))", "legendFormat": "{{result}}"}]},
    {"id": 3, "title": "Processing p50 / p95 / p99", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(commerce_processor_event_processing_duration_seconds_bucket[5m])))", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(commerce_processor_event_processing_duration_seconds_bucket[5m])))", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(commerce_processor_event_processing_duration_seconds_bucket[5m])))", "legendFormat": "p99"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 4, "title": "Validation failures by category", "type": "timeseries", "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8}, "targets": [{"expr": "sum by (category) (rate(commerce_processor_validation_failures_total[5m]))", "legendFormat": "{{category}}"}]},
    {"id": 5, "title": "Retries and DLQ", "type": "timeseries", "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8}, "targets": [{"expr": "sum(rate(commerce_processor_retries_total[5m]))", "legendFormat": "retries"}, {"expr": "sum(rate(commerce_processor_dlq_published_total[5m]))", "legendFormat": "DLQ"}]},
    {"id": 6, "title": "Redis operation latency", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, operation) (rate(commerce_idempotency_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}} p95"}]},
    {"id": 7, "title": "Database and offset latency", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(commerce_database_transaction_duration_seconds_bucket[5m])))", "legendFormat": "DB p95"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(commerce_processor_offset_commit_duration_seconds_bucket[5m])))", "legendFormat": "commit p95"}]},
    {"id": 8, "title": "Inflight and assigned partitions", "type": "timeseries", "gridPos": {"h": 8, "w": 4, "x": 16, "y": 16}, "targets": [{"expr": "commerce_processor_inflight_events", "legendFormat": "inflight"}, {"expr": "commerce_processor_assigned_partitions", "legendFormat": "assigned"}]},
    {"id": 9, "title": "Processor health", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 16}, "targets": [{"expr": "commerce_processor_healthy"}]},
    {"id": 10, "title": "Seconds since last success", "type": "stat", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 20}, "targets": [{"expr": "time() - commerce_processor_last_success_timestamp_seconds"}], "fieldConfig": {"defaults": {"unit": "s"}}}
  ]
}
