{
  "uid": "commerce-infrastructure", "title": "Platform Infrastructure", "description": "Kafka, PostgreSQL, Redis, and Prometheus exporter health and resource signals.", "schemaVersion": 41, "version": 1, "refresh": "10s", "time": {"from": "now-1h", "to": "now"}, "tags": ["commerce", "infrastructure"], "templating": {"list": []},
  "panels": [
    {"id": 1, "title": "Exporter and scrape target health", "type": "stat", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}, "targets": [{"expr": "up", "legendFormat": "{{job}}"}]},
    {"id": 2, "title": "Kafka topic / partition count", "type": "stat", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0}, "targets": [{"expr": "count(kafka_topic_partitions)", "legendFormat": "topics"}, {"expr": "sum(kafka_topic_partitions)", "legendFormat": "partitions"}]},
    {"id": 3, "title": "Kafka consumer groups", "type": "stat", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0}, "targets": [{"expr": "count(count by (consumergroup) (kafka_consumergroup_lag))"}]},
    {"id": 4, "title": "PostgreSQL connections and transactions", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6}, "targets": [{"expr": "sum(pg_stat_activity_count{datname=\"commerce\"})", "legendFormat": "connections"}, {"expr": "rate(pg_stat_database_xact_commit{datname=\"commerce\"}[5m])", "legendFormat": "commits/s"}, {"expr": "rate(pg_stat_database_xact_rollback{datname=\"commerce\"}[5m])", "legendFormat": "rollbacks/s"}]},
    {"id": 5, "title": "PostgreSQL deadlocks and size", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6}, "targets": [{"expr": "rate(pg_stat_database_deadlocks{datname=\"commerce\"}[5m])", "legendFormat": "deadlocks/s"}, {"expr": "pg_database_size_bytes{datname=\"commerce\"}", "legendFormat": "bytes"}]},
    {"id": 6, "title": "Redis memory and clients", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6}, "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "memory"}, {"expr": "redis_connected_clients", "legendFormat": "clients"}]},
    {"id": 7, "title": "Redis commands and keyspace", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14}, "targets": [{"expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "commands/s"}, {"expr": "rate(redis_keyspace_hits_total[5m])", "legendFormat": "hits/s"}, {"expr": "rate(redis_keyspace_misses_total[5m])", "legendFormat": "misses/s"}]},
    {"id": 8, "title": "Redis evictions and expirations", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14}, "targets": [{"expr": "rate(redis_evicted_keys_total[5m])", "legendFormat": "evictions/s"}, {"expr": "rate(redis_expired_keys_total[5m])", "legendFormat": "expired/s"}]},
    {"id": 9, "title": "Prometheus scrape duration and samples", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14}, "targets": [{"expr": "scrape_duration_seconds", "legendFormat": "{{job}} duration"}, {"expr": "scrape_samples_scraped", "legendFormat": "{{job}} samples"}]}
  ]
}
