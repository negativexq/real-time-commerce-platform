{
  "uid": "commerce-fraud", "title": "Rule-Based Fraud Engine", "description": "Synthetic explainable rules only; not a production fraud decision system. Persona is never a scoring metric or signal.", "schemaVersion": 41, "version": 1, "refresh": "10s", "time": {"from": "now-1h", "to": "now"}, "tags": ["commerce", "fraud"], "templating": {"list": []},
  "panels": [
    {"id": 1, "title": "APPROVE / REVIEW / BLOCK rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (decision) (rate(commerce_fraud_evaluations_total[5m]))", "legendFormat": "{{decision}}"}]},
    {"id": 2, "title": "Current decision distribution", "type": "piechart", "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "sum by (decision) (increase(commerce_fraud_evaluations_total[1h]))", "legendFormat": "{{decision}}"}]},
    {"id": 3, "title": "Fraud score histogram", "type": "heatmap", "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "sum by (le) (rate(commerce_fraud_score_bucket[5m]))", "format": "heatmap"}]},
    {"id": 4, "title": "Evaluation p50 / p95 / p99", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(commerce_fraud_evaluation_duration_seconds_bucket[5m])))", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(commerce_fraud_evaluation_duration_seconds_bucket[5m])))", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(commerce_fraud_evaluation_duration_seconds_bucket[5m])))", "legendFormat": "p99"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 5, "title": "Alerts by decision and severity", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}, "targets": [{"expr": "sum by (decision, severity) (rate(commerce_fraud_alerts_created_total[5m]))", "legendFormat": "{{decision}} {{severity}}"}]},
    {"id": 6, "title": "Top matched rules", "type": "barchart", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}, "targets": [{"expr": "topk(10, sum by (rule_id) (increase(commerce_fraud_rule_matches_total[1h])))", "legendFormat": "{{rule_id}}"}]},
    {"id": 7, "title": "Rule execution latency", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, rule_id) (rate(commerce_fraud_rule_duration_seconds_bucket[5m])))", "legendFormat": "{{rule_id}}"}]},
    {"id": 8, "title": "Rule errors and context failures", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}, "targets": [{"expr": "sum(rate(commerce_fraud_rule_evaluations_total{result=\"error\"}[5m]))", "legendFormat": "rule errors"}, {"expr": "sum(rate(commerce_fraud_context_failures_total[5m]))", "legendFormat": "context failures"}]},
    {"id": 9, "title": "Seconds since last evaluation", "type": "stat", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}, "targets": [{"expr": "time() - commerce_fraud_last_evaluation_timestamp_seconds"}], "fieldConfig": {"defaults": {"unit": "s"}}}
  ]
}
